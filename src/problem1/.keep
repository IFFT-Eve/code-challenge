var sum_to_n_a = function (n) {
  let sum = 0;
  for (let i = 1; i <= n; i++) {
    sum += i;
  }
  return sum;
};

// n*(n+1)= 2* sum(n)
// (n+1)*(n+1) - n - 1 = 2 * sum(n)
var sum_to_n_b = function (n) {
  return ((n + 1) ** 2 - n - 1) / 2;
};

var sum_to_n_c = function (n) {
  return (n * (n + 1)) / 2;
};
